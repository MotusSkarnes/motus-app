VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Valgfritt men anbefalt i produksjon: Fast URL for e-postlenker (invitasjon, OTP, passord).
# Prod (Motus på Vercel): https://motus-pt-app.vercel.app  — også i Vercel → Environment Variables.
# Sett samme verdi som Supabase secret PUBLIC_APP_URL på invite-member (uten trailing slash).
# VITE_SITE_URL=https://motus-pt-app.vercel.app

# Web Push (VAPID public key only — safe to expose).
# Generate: npx web-push generate-vapid-keys
# Also set Supabase Edge secrets: VAPID_PUBLIC_KEY (same value), VAPID_PRIVATE_KEY, VAPID_CONTACT (e.g. mailto:pt@firma.no)
VITE_VAPID_PUBLIC_KEY=
