{
  "name": "motus-pt-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:icons": "node ./scripts/generate-pwa-icons.mjs",
    "generate:test-plans": "node ./scripts/generate-test-plans.mjs",
    "generate:food-micronutrients": "node ./scripts/enrich-food-bank-micronutrients.mjs",
    "prebuild": "npm run generate:icons",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "postbuild": "node ./scripts/write-service-worker.mjs",
    "test": "vitest run",
    "check:supabase-env": "node ./scripts/check-supabase-env.mjs",
    "check:supabase-schema": "node ./scripts/check-supabase-schema.mjs",
    "check:production-readiness": "node ./scripts/check-production-readiness.mjs",
    "check:rls-security": "node ./scripts/check-rls-security-patches.mjs",
    "supabase:deploy-core": "npx supabase functions deploy hydrate-trainer-data && npx supabase functions deploy hydrate-member-data && npx supabase functions deploy link-member-auth && npx supabase functions deploy invite-member && npx supabase functions deploy archive-member && npx supabase functions deploy delete-member && npx supabase functions deploy restore-member && npx supabase functions deploy send-chat-message && npx supabase functions deploy delete-member-period-plan",
    "generate:rehab-sketches": "node ./scripts/generate-rehab-medical-sketches.mjs",
    "supabase:deploy-onboarding": "npx supabase functions deploy update-member-profile && npx supabase functions deploy hydrate-trainer-data && npx supabase functions deploy hydrate-member-data",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "pdfkit": "^0.18.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
